# =====================================================================
# WristAI - Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND SERVICE ENVIRONMENT VARIABLES (Railway Service: wristai-backend)
# ---------------------------------------------------------------------
# Server Port (Railway automatically sets PORT; default fallback 8000)
PORT=8000
HOST=0.0.0.0

# Secret Key for Signing JWT Access Tokens
JWT_SECRET=wristai_hospital_super_secret_jwt_key_2026_xray

# Database URL
# Default (SQLite file stored in data_store):
DATABASE_URL=sqlite:///backend/data_store/wristai_hospital.db
# If Railway PostgreSQL is attached, Railway automatically sets DATABASE_URL:
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway

# Allowed CORS Origins (Comma-separated list or * for all)
# In production, set this to your Railway frontend domain:
# e.g., https://wristai-frontend-production.up.railway.app
CORS_ORIGINS=*

# ---------------------------------------------------------------------
# FRONTEND SERVICE ENVIRONMENT VARIABLES (Railway Service: wristai-frontend)
# ---------------------------------------------------------------------
# Public Backend URL (Generated by Railway for the backend service)
# Example: https://wristai-backend-production.up.railway.app
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# DEFAULT DEMO ACCOUNTS (Pre-seeded on initial startup)
# ---------------------------------------------------------------------
