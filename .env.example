# =====================================================================
# WristAI - Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND ENVIRONMENT (Render / Railway / Production)
# ---------------------------------------------------------------------
# Set to 'production' on Render/Railway; 'development' for local work
ENVIRONMENT=production

# Server Port (Render sets PORT=10000; Railway sets PORT dynamically)
PORT=10000
HOST=0.0.0.0

# Cryptographically Secure JWT Secret Key (Required in production - minimum 32 chars)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_key_here

# Production CORS Origins: Set to exact frontend deployed URL
# Render example: https://wristai-frontend.onrender.com
# Railway example: https://wristai-frontend.up.railway.app
CORS_ORIGINS=https://wristai-frontend.onrender.com

# Database Connection URL:
# 1. SQLite (Default local file):
DATABASE_URL=sqlite:///backend/data_store/wristai_hospital.db
# 2. Render / Railway Managed PostgreSQL (Native support via psycopg2-binary):
# DATABASE_URL=postgresql://user:password@host.render.com:5432/wristai_db

# Persistent Storage Directories (Optional - for Persistent Disks mounted at /var/data)
# UPLOADS_DIR=/var/data/uploads
# DB_DIR=/var/data

# Initial Production Administrator & Doctor Accounts (Required in production)
INITIAL_DOCTOR_EMAIL=dr.ananya@wristai.hospital
INITIAL_DOCTOR_PASSWORD=replace_with_strong_doctor_password_here
INITIAL_DOCTOR_NAME=Dr. Ananya S

INITIAL_ADMIN_EMAIL=admin@wristai.hospital
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password_here
INITIAL_ADMIN_NAME=Hospital Administrator

# ---------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES
# ---------------------------------------------------------------------
# Public Backend URL (Generated by Render or Railway for backend service)
# Example Render: https://wristai-backend.onrender.com
# Example Railway: https://wristai-backend-production.up.railway.app
VITE_API_BASE_URL=https://wristai-backend.onrender.com
